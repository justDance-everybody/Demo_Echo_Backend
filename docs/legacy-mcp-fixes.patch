+    def _replace_env_placeholders(self, server_configs: dict) -> dict:
+        """
+        替换配置文件中的环境变量占位符
+        
+        Args:
+            server_configs: 服务器配置字典
+            
+        Returns:
+            dict: 替换后的配置字典
+        """
+        import re
+        
+        def replace_placeholders(obj):
+            """递归替换对象中的占位符"""
+            if isinstance(obj, dict):
+                return {k: replace_placeholders(v) for k, v in obj.items()}
+            elif isinstance(obj, list):
+                return [replace_placeholders(item) for item in obj]
+            elif isinstance(obj, str):
+                # 查找 {ENV_VAR_NAME} 格式的占位符
+                matches = re.findall(r'\{([^}]+)\}', obj)
+                for match in matches:
+                    env_value = os.getenv(match)
+                    if env_value:
+                        obj = obj.replace(f'{{{match}}}', env_value)
+                        logger.info(f"替换占位符 {{{match}}} -> {env_value}")
+                    else:
+                        logger.warning(f"环境变量 {match} 未设置，使用原始值")
+                return obj
+            else:
+                return obj
+        
+        # 深拷贝配置以避免修改原始数据
+        import copy
+        replaced_configs = copy.deepcopy(server_configs)
+        
+        # 替换所有占位符
+        replaced_configs = replace_placeholders(replaced_configs)
+        
+        logger.info("已完成环境变量占位符替换")
+        return replaced_configs
