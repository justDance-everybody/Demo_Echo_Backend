# ==============================================
# Echo 智能语音 AI-Agent 开放平台 - 环境配置模板
# ==============================================
# 
# 使用说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 修改下面的配置项为您的实际值
# 3. 请勿将 .env 文件提交到版本控制系统
# 

# 应用基础配置
APP_NAME="AI Assistant API"
VERSION="0.1.0"
API_PREFIX="/api/v1"
ENV="development"
DEBUG=True

# 服务器配置
HOST=0.0.0.0
PORT=3000

# 数据库配置 (MySQL) - 必填
DATABASE_URL="mysql+pymysql://username:password@host:port/database_name"
DATABASE_NAME="ai_assistant"

# LLM配置 (必填) - 支持 OpenAI 兼容接口
LLM_API_KEY="your_llm_api_key_here"
LLM_API_BASE="https://api.openai.com/v1"
LLM_MODEL="gpt-3.5-turbo"
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# MCP 客户端配置 (旧版，保留)
MCP_CLIENT_PATH="./MCP_Client"
MCP_SERVERS_PATH="./MCP_Client/config/mcp_servers.json"

# MCPRouter 配置 (新版，推荐)
MCPROUTER_BASE_URL="http://127.0.0.1:8027"
MCPROUTER_API_KEY="fetch"
MCPROUTER_TIMEOUT=30.0
USE_MCPROUTER=false

# 日志配置
LOG_LEVEL="INFO"
LOG_FILE="logs/api.log"

# CORS 配置
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","*"]

# JWT 认证配置 (自动生成，可选)
JWT_SECRET="your-jwt-secret-key-will-be-generated-automatically"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION=10080

# 功能开关
USE_MOCK_RESPONSES=false

# ==============================================
# 测试用户账号配置（可选）
# ==============================================

# 普通用户测试账号
TEST_USER_USERNAME="testuser"
TEST_USER_PASSWORD="test_password"

# 开发者测试账号
TEST_DEVELOPER_USERNAME="devuser"
TEST_DEVELOPER_PASSWORD="dev_password"

# 管理员测试账号
TEST_ADMIN_USERNAME="adminuser"
TEST_ADMIN_PASSWORD="admin_password"

# ==============================================
# 第三方服务配置（可选）
# ==============================================

# OpenAI API密钥（备用）
OPENAI_API_KEY=your_openai_api_key

# Solana钱包私钥（请务必保管好私钥！）
SOLANA_PRIVATE_KEY=your_solana_private_key

# Solana RPC节点URL（可以使用公共节点或私有节点）
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
