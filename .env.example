# ===========================================
# 应用基础配置
# ===========================================
# 此部分包含应用程序的基本设置，如名称、环境、端口等。
# 这些参数决定了应用的运行方式和对外提供服务的基本信息。

APP_NAME=EchoAI
ENV=development  # development, testing, production
DEBUG=true
APP_VERSION=0.1.0
API_PREFIX=/api/v1
PORT=3000
HOST=0.0.0.0

# ===========================================
# 数据库配置
# ===========================================
# 数据库连接参数，用于连接MySQL数据库，存储用户、工具、会话等信息。
# 需要确保数据库已创建，且用户具有足够权限。
# 生产环境必须设置DATABASE_URL，否则将使用SQLite

DATABASE_URL=mysql+pymysql://your_user:your_password@your_host:3306/your_database
DB_USER=root
DB_PASSWORD=your_strong_password
DB_HOST=your_host
DB_PORT=3306
DB_NAME=echo_db

# ===========================================
# 认证配置
# ===========================================
# JWT令牌生成和验证的相关参数，用于用户身份验证和权限控制。
# JWT_SECRET必须保密且足够复杂，以确保系统安全。
# 生产环境必须设置JWT_SECRET！

JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION=10080  # 7天有效期（分钟）

# CORS配置
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,*

# ===========================================
# LLM配置
# ===========================================
# 大语言模型通用配置，支持多种模型提供商。这些参数控制LLM的调用方式、
# 响应特性和超时设置，影响系统的意图理解和文本生成质量。
# 生产环境必须设置这些参数！

# 推荐Qwen/Qwen3-30B-A3B，测试过足够稳定，openai等也可以
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
LLM_API_BASE=https://api.siliconflow.cn/v1 ##可以改为你指定的api_base
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1  # 0.0-2.0，越低越精确，越高越创造性
LLM_MAX_TOKENS=1000

# ===========================================
# OpenAI特定配置
# ===========================================
# 当使用OpenAI作为LLM提供商时的特定设置，这些参数与LLM配置协同工作，
# 但专门针对OpenAI的API特性进行优化。

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# ===========================================
# MCP配置
# ===========================================
# 多链协议(Multi-Chain Protocol)相关设置，用于与区块链、Web3服务和其他
# 外部工具的集成。这些参数控制MCP客户端的连接和调用行为。

MCP_SCRIPT_PATH=../../MCP_Client/src/mcp/client/main.py
MCP_MAX_RETRY=3
MCP_TIMEOUT_MS=30000
MCP_API_BASE_URL=http://localhost:3000
MCP_API_KEY=your_mcp_api_key

# ===========================================
# 版本检查配置
# ===========================================
# 依赖版本兼容性检查相关设置，用于预防版本不兼容导致的问题。
# 这些参数控制启动时的版本检查行为和错误处理策略。

# 是否启用启动时版本检查（true/false）
VERSION_CHECK_ENABLED=true

# 是否在版本检查失败时强制退出（true/false）
VERSION_CHECK_STRICT=false

# 版本检查超时时间（秒）
VERSION_CHECK_TIMEOUT=10

# 是否在MCP连接错误时显示版本检查建议（true/false）
VERSION_SUGGEST_ON_ERROR=true

# ===========================================
# 区块链配置
# ===========================================
# 区块链相关API配置，用于Web3功能

SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_solana_api_key_here

# ===========================================
# 测试账户配置
# ===========================================
# 用于创建测试账户的默认配置，可根据需要修改

TEST_DEV_USERNAME=devuser_xxxx
TEST_DEV_PASSWORD=your_dev_password
TEST_DEV_ROLE=developer

TEST_USER_USERNAME=testuser_xxxx
TEST_USER_PASSWORD=your_user_password
TEST_USER_ROLE=user

TEST_ADMIN_USERNAME=adminuser_xxxx
TEST_ADMIN_PASSWORD=your_admin_password
TEST_ADMIN_ROLE=admin

# ===========================================
# 日志配置
# ===========================================
# 系统日志记录相关设置，用于调试和监控系统运行状态。
# 生产环境建议设置为INFO或更高级别。

LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_PATH=logs/