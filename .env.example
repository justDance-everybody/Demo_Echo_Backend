# 复制成 .env 后填两项：ECHO_PROVIDER_URL 和 ECHO_PROVIDER_API_KEY。echo-server 启动时自动读取 .env。
# Copy to .env and fill in ECHO_PROVIDER_URL and ECHO_PROVIDER_API_KEY. echo-server loads .env on startup.

# 实时语音模型，默认阿里云百炼 Qwen-Omni-Realtime（https://bailian.console.aliyun.com/）
# API key：百炼控制台的 API-Key 页面创建。
# 地址：把 <WorkspaceId> 换成百炼业务空间 ID（形如 llm-xxxxxxxx），本项目的实测都用这种地址：
#   北京：  wss://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
#   新加坡：wss://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/api-ws/v1/realtime
# 百炼也有不带业务空间的通用地址 wss://dashscope.aliyuncs.com/api-ws/v1/realtime，本项目没有用它实测过。
ECHO_DIALECT=qwen
ECHO_PROVIDER_URL=
ECHO_PROVIDER_API_KEY=
ECHO_MODEL=qwen3.8-omni-flash-realtime
ECHO_VOICE=Tina

# 换 OpenAI Realtime（协议已实现，尚未用真模型验证）：
# OpenAI Realtime (implemented, not yet verified against the live model):
# ECHO_DIALECT=openai
# ECHO_PROVIDER_URL=wss://api.openai.com/v1/realtime
# ECHO_MODEL=gpt-realtime
# ECHO_VOICE=marin

# 公网部署必须设置；不设时只接受本机连接
ECHO_ACCESS_TOKEN=
ECHO_HOST=127.0.0.1
ECHO_PORT=8000

# tools.yaml 里远程 MCP 用到的密钥，例如：
# AMAP_KEY=
