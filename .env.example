# 实时语音模型（默认阿里云百炼 Qwen-Omni-Realtime）
# 北京地域：wss://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# 新加坡：  wss://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/api-ws/v1/realtime
ECHO_DIALECT=qwen
ECHO_PROVIDER_URL=wss://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
ECHO_PROVIDER_API_KEY=
ECHO_MODEL=qwen3.8-omni-flash-realtime
ECHO_VOICE=Tina

# 换 OpenAI Realtime：
# ECHO_DIALECT=openai
# ECHO_PROVIDER_URL=wss://api.openai.com/v1/realtime
# ECHO_MODEL=gpt-realtime
# ECHO_VOICE=marin

# 公网部署必须设置；不设时只接受本机连接
ECHO_ACCESS_TOKEN=
ECHO_HOST=127.0.0.1
ECHO_PORT=8000

# tools.yaml 里远程 MCP 用到的密钥，例如：
# AMAP_KEY=
