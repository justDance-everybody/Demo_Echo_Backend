# ==========================================
# MCP_Client 环境变量配置模板
# ==========================================
# 复制此文件为 .env 并填入真实的配置值
# 
# 注意：LLM配置可以直接使用backend/.env中的配置，
# 只有在需要不同配置时才需要在此文件中设置

# ==========================================
# LLM 配置（可选 - 如不设置将使用backend/.env中的配置）
# ==========================================
# LLM_API_KEY="your-openai-api-key-here"
# LLM_API_BASE="https://api.openai.com/v1" 
# LLM_MODEL="gpt-4o"

# ==========================================
# MCP 服务器配置
# ==========================================
# MCP 服务器配置文件路径
MCP_SERVERS_PATH="config/mcp_servers.json"

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL="INFO"
LOG_FILE="logs/mcp_client.log"

# ==========================================
# 连接配置
# ==========================================
# 连接超时时间（秒）
CONNECTION_TIMEOUT=30
# 重试次数
MAX_RETRY_ATTEMPTS=3
# 重试延迟（秒）
RETRY_DELAY=2

# ==========================================
# 开发调试
# ==========================================
# 是否启用调试模式
DEBUG_MODE=false
# 是否显示详细日志
VERBOSE=false